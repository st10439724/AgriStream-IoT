@{
    ViewData["Title"] = "Upload drone image";
}
<h2>Upload drone image</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Upload" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label">Field ID</label>
        <input name="fieldId" class="form-control" value="FIELD-A" />
    </div>
    <div class="mb-3">
        <label class="form-label">Image</label>
        <input type="file" name="file" class="form-control" accept=".jpg,.jpeg,.png" />
    </div>
    <button type="submit" class="btn btn-primary">Upload</button>
    <a asp-action="Gallery" class="btn btn-link">View uploads</a>
</form>